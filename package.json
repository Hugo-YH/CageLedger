{
  "name": "cageledger",
  "private": true,
  "version": "1.32.0",
  "build": 281,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Hugo <info@cellnucle.us>",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "start": "npm run build && node scripts/check_python_runtime.mjs && node scripts/run_python.mjs server.py",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build_all.mjs",
    "build:app": "vite build",
    "docs:dev": "vitepress dev wiki --port 5175",
    "docs:build": "vitepress build wiki --outDir .vitepress/dist",
    "check:docs": "npm run docs:build",
    "release:notes:sync": "node scripts/sync_release_notes_from_docs.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run_python.mjs scripts/verify_local.py all-unit",
    "test:python": "node scripts/run_python.mjs scripts/verify_local.py all-python",
    "test:e2e": "node scripts/run_python.mjs scripts/verify_local.py e2e",
    "benchmark": "node scripts/run_python.mjs scripts/benchmark_performance.py",
    "check:architecture": "node scripts/check_architecture.mjs",
    "api:inventory": "node scripts/run_python.mjs scripts/api_inventory.py --write",
    "check:api": "node scripts/run_python.mjs scripts/api_inventory.py --check",
    "verify:database": "node scripts/run_python.mjs scripts/verify_database_copy.py",
    "verify:restore": "node scripts/run_python.mjs scripts/verify_restore.py",
    "check:ui-contract": "node scripts/check_ui_contract.mjs",
    "check:style-ownership": "node scripts/check_style_ownership.mjs",
    "check:antd-design": "node scripts/check_antd_design.mjs",
    "format": "prettier --write . && node scripts/run_python.mjs -m ruff format .",
    "format:check": "prettier --check . && node scripts/run_python.mjs -m ruff format --check .",
    "lint": "npm run lint:ts && npm run lint:css && npm run lint:md && npm run lint:python && npm run lint:shell",
    "lint:ts": "eslint . --max-warnings 0",
    "lint:css": "stylelint 'src/**/*.css'",
    "lint:md": "markdownlint-cli2",
    "lint:python": "node scripts/run_python.mjs -m ruff check .",
    "lint:shell": "bash -n scripts/*.sh && shellcheck scripts/*.sh",
    "check": "node scripts/run_python.mjs scripts/verify_local.py check",
    "verify:full": "node scripts/run_python.mjs scripts/verify_local.py full",
    "smoke:api": "node scripts/smoke_api.mjs",
    "package:offline": "bash scripts/package_offline.sh",
    "package:offline:image": "bash scripts/package_offline_image.sh",
    "package:container": "bash scripts/build_container_package.sh",
    "prewarm:container:local": "bash scripts/prewarm_container_deps.sh",
    "publish:container:local": "bash scripts/publish_container_local.sh",
    "release:local": "bash scripts/release_local.sh",
    "release:doctor": "bash scripts/release_local.sh --doctor",
    "release:status": "bash scripts/release_local.sh --status",
    "test:e2e:compat": "node scripts/run_python.mjs scripts/verify_local.py compat",
    "check:steps": "npm run check:quality && node node_modules/vitest/vitest.mjs run --maxWorkers=1 --passWithNoTests=false && node scripts/run_python.mjs -m unittest discover -s tests -p 'test_*.py'",
    "test:target": "node scripts/run_python.mjs scripts/verify_local.py unit",
    "test:related": "node scripts/run_python.mjs scripts/verify_local.py related",
    "test:python:target": "node scripts/run_python.mjs scripts/verify_local.py python",
    "package:managed": "node scripts/run_python.mjs scripts/verify_local.py package",
    "publish:cloud": "node scripts/run_python.mjs scripts/cloud_package_delivery.py",
    "release:cloud": "node scripts/run_python.mjs scripts/cloud_release.py",
    "publish:registry": "node scripts/run_python.mjs scripts/cloud_registry.py",
    "check:quality": "npm run format:check && npm run lint && npm run typecheck && npm run check:architecture -- --enforce && npm run check:frontend-lifecycle && npm run check:api && npm run check:ui-contract && npm run check:style-ownership && npm run check:antd-design",
    "verify:quality": "node scripts/run_python.mjs scripts/verify_local.py quality",
    "build:shared": "node scripts/run_python.mjs scripts/frontend_build.py build",
    "runtime:refresh": "node scripts/run_python.mjs scripts/runtime_image.py refresh",
    "check:frontend-lifecycle": "node scripts/check_frontend_lifecycle.mjs --check"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.2",
    "@ant-design/plots": "^2.6.8",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-virtual": "^3.14.4",
    "antd": "6.5.2",
    "antd-mobile": "5.42.3",
    "markdown-it": "14.3.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-resizable": "^4.0.2"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.6.0",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-resizable": "^3.0.8",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.9.4",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "8.1.6",
    "vitepress": "^1.6.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "markdown-it": "14.3.3",
    "linkify-it": "5.0.2"
  }
}
